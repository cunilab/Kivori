{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": ["libpulse0", "libudev1"],
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/60-kivori.rules": "linux/60-kivori.rules"
        },
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
