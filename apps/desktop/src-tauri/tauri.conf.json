{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kivori",
  "version": "0.1.0",
  "identifier": "id.immer.kivori",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kivori",
