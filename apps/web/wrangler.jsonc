{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivori-web",
  "workers_dev": true,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kivori-web",
    },
  ],
  // Analytics Engine datasets are created on first write; the bindings need no setup. DOWNLOADS is
  // the download counter (W3).
  // Waitlist sign-up counts (W4): blobs [product, utm_source], no email.
  "analytics_engine_datasets": [
    { "binding": "DOWNLOADS", "dataset": "kivori_downloads" },
    { "binding": "SIGNUPS", "dataset": "kivori_signups" },
  ],
  // Waitlist storage (W4). Apply migrations: see README.
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "kivori-web",
      "database_id": "6e9f114c-9121-4eaf-a0ef-639a0358b672",
      "migrations_dir": "migrations",
    },
  ],
  // Per-IP limit on sign-ups: 5 per 60 s. The IP is only the limiter key and is never stored.
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "TURNSTILE_SITE_KEY",
      "store_id": "276d4d35c03b4fec9303b1f46e67379c",
      "secret_name": "TURNSTILE_SITE_KEY",
    },
    {
      "binding": "TURNSTILE_SECRET_KEY",
      "store_id": "276d4d35c03b4fec9303b1f46e67379c",
      "secret_name": "TURNSTILE_SECRET_KEY",
    },
  ],
  "vars": {
    // Owner-selected public support/privacy address; mailbox delivery is verified before launch.
    "CONTACT_EMAIL": "andresholivin01@gmail.com",
  },
}
