{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivori-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kivori-web",
    },
  ],
  // Download counter (W3). The dataset is created on first write; the binding needs no setup.
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "kivori_downloads" }],
  // Later slices, intentionally absent: D1 + Turnstile + rate limiting (W4).
}
