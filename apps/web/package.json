{
  "name": "kivori-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun scripts/build-product-catalog.mjs && bun scripts/build-assets.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "bun scripts/build-product-catalog.mjs && bun scripts/build-assets.mjs",
    "build": "next build",
    "pretypecheck": "bun scripts/build-product-catalog.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "bun scripts/build-product-catalog.mjs",
    "test": "vitest run",
    "assets": "bun scripts/build-product-catalog.mjs && bun scripts/build-assets.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "preview": "bun run assets && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run assets && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@kivori/ui": "workspace:*",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "25.16.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "0.187.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "4.156.0"
  }
}
