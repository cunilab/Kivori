{
  "name": "kivori-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun scripts/build-assets.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "bun scripts/build-assets.mjs",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "assets": "bun scripts/build-assets.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "preview": "bun run assets && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run assets && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@kivori/ui": "workspace:*",
    "geist": "^1.7.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "25.13.0",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "4.149.0"
  }
}
